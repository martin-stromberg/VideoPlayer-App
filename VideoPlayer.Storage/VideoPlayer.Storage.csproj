<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Copyright (c) Martin Stromberg</Copyright>
    <Authors>Martin Stromberg</Authors>
  </PropertyGroup>
  <ItemGroup>
    <!-- ILogger/ILoggerProvider für das Datei-Protokoll (AppLogService/
         FileLoggerProvider) — deckungsgleiche Version mit
         Microsoft.Extensions.Logging.Debug in VideoPlayer.Maui. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" />
    <!-- Rein verwalteter Provider für die System-libsqlite3 — kommt
         bereits transitiv via sqlite-net-pcl (>= 3.0.3) herein, die
         Direktreferenz fixiert nur die Version und macht die Nutzung in
         SqliteBootstrap explizit. Aktiviert wird der Provider
         ausschließlich unter tvOS zur Laufzeit:
         SQLitePCLRaw.lib.e_sqlite3.tvos liefert kein
         tvossimulator-arm64-Binary, der Simulator-Link schlägt dort sonst
         fehl. Auf Windows/Android/macOS bleibt die Assembly ungenutzt
         (kein Verhaltenswechsel). -->
    <PackageReference Include="SQLitePCLRaw.provider.sqlite3" Version="3.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
