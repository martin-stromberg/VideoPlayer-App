<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Stub-Assembly mit dem Assembly-Namen "SQLitePCLRaw.lib.e_sqlite3.tvos".
    Das NuGet-Paket liefert eine Managed-DLL mit eingebettetem e_sqlite3.a,
    dessen Slices (tvos-arm64 + tvossimulator-x64) keine tvossimulator-arm64
    enthalten. VideoPlayer.TvOS referenziert das Paket daher mit
    ExcludeAssets="all" und linkt retaggte Archive selbst. Batteries_V2
    (SQLitePCLRaw.batteries_v2) referenziert die Managed-Assembly trotzdem
    statisch — ohne sie schlaegt der AOT-Assemblyloader beim Start fehl.
    Dieser Stub loest die Referenz auf; der eigentliche Provider kommt
    ueber SQLitePCL.SQLite3Provider_internal (provider.internal).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SQLitePCLRaw.lib.e_sqlite3.tvos</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
