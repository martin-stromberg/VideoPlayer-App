<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!-- Runtime-/workload-Packs (z. B. Microsoft.NETCore.App.Runtime.Mono.win-x64)
         liegen nicht auf nuget.org, sondern im offiziellen dotnet10-Band-Feed;
         sonst schlaegt der MAUI-Windows-Build mit NU1102 fehl. -->
    <add key="dotnet10" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet10/nuget/v3/index.json" />
  </packageSources>
</configuration>
