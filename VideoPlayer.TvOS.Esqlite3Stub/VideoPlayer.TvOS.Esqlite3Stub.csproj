<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Stub-Assembly mit dem Assembly-Namen "SQLitePCLRaw.lib.e_sqlite3"
    (generisches Paket). provider.e_sqlite3 referenziert sie statisch;
    die Managed-DLL des generischen Pakets wird im tvOS-Bundle nicht
    aufgeloest (tvOS-RID waehlt die .tvos-Variante). Stub loest die
    Referenz auf; der Provider kommt ueber provider.internal.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SQLitePCLRaw.lib.e_sqlite3</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
