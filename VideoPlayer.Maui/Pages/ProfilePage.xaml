<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mvu="clr-namespace:VideoPlayer.Mvu;assembly=VideoPlayer.Mvu"
             x:Class="VideoPlayer.Maui.Pages.ProfilePage"
             Title="Profil"
             x:DataType="mvu:MvuHost">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="{Binding Model.Profile.IsLoading}"
                               IsVisible="{Binding Model.Profile.IsLoading}"
                               Color="{StaticResource VpPrimary}" />

            <!-- Offline-Hinweis: ohne Serververbindung stehen die
                 Profilinformationen nicht zur Verfügung. -->
            <Border x:Name="ProfileOfflineBanner"
                    Style="{StaticResource Banner}"
                    IsVisible="False">
                <Label Text="Offline-Modus – Profilinformationen stehen ohne Serververbindung nicht zur Verfügung."
                       TextColor="{StaticResource VpText}"
                       FontFamily="InterMedium" />
            </Border>

            <!-- Angemeldeter Server-Benutzer: Benutzername und E-Mail aus
                 den Claims des Anmelde-Tokens bzw. der gespeicherten
                 Anmelde-Kennung (kein Benutzerinfo-Endpunkt vorhanden). -->
            <Border x:Name="UserInfoBorder"
                    Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="ANGEMELDETER BENUTZER"
                           Style="{StaticResource Kicker}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Benutzername"
                               Style="{StaticResource Caption}"
                               FontSize="13" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding Model.Profile.UsernameText}"
                               FontFamily="InterSemiBold" />
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="E-Mail"
                               Style="{StaticResource Caption}"
                               FontSize="13" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding Model.Profile.EmailText}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Lokale Installation: aktives Profil und verbundener Server. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="LOKALE INSTALLATION"
                           Style="{StaticResource Kicker}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Profil"
                               Style="{StaticResource Caption}"
                               FontSize="13" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding Model.Profile.ProfileNameText}"
                               FontFamily="InterSemiBold" />
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Server"
                               Style="{StaticResource Caption}"
                               FontSize="13" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding Model.ActiveServerAddress}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Abmelden: beendet die Sitzung lokal (Token/Zugangsdaten
                 werden verworfen) und führt zur Anmeldemaske. -->
            <Button x:Name="LogoutButton"
                    Text="Abmelden"
                    Style="{StaticResource SecondaryButton}"
                    TextColor="{StaticResource VpDanger}"
                    Clicked="OnLogoutClicked"
                    HorizontalOptions="Start" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
