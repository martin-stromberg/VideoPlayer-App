<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VideoPlayer.Maui.Pages.HomePage"
             Title="Startseite">

    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Startseite" FontSize="24" FontAttributes="Bold" />
        <Label Text="Diese Seite wird in einem späteren Entwicklungsschritt gefüllt." />
        <Label x:Name="ServerStatusLabel"
               AutomationId="ServerStatusLabel"
               Text="{Binding Model.ServerHealthText}"
               FontSize="12" />
    </VerticalStackLayout>

</ContentPage>
