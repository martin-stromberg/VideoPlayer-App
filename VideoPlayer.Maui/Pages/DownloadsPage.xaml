<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mvu="clr-namespace:VideoPlayer.Mvu;assembly=VideoPlayer.Mvu"
             x:Class="VideoPlayer.Maui.Pages.DownloadsPage"
             x:Name="RootPage"
             Title="Downloads"
             x:DataType="mvu:MvuHost">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12">

        <!-- Kontingent-Belegung des Speicherplatzes für Downloads. -->
        <Label x:Name="QuotaLabel"
               Grid.Row="0"
               FontSize="12"
               TextColor="#BBBBBB" />

        <!-- Hinweis im Offline-Zustand: die Liste liegt lokal vor;
             wartende Downloads starten mit der Verbindung. -->
        <Border x:Name="OfflineBanner"
                Grid.Row="1"
                Padding="12,8"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="#D9A029"
                IsVisible="False">
            <Label Text="Offline – Downloads werden fortgesetzt, sobald eine Verbindung besteht."
                   TextColor="Black"
                   FontAttributes="Bold" />
        </Border>

        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="2"
                           IsRunning="{Binding Model.Downloads.IsLoading}"
                           IsVisible="{Binding Model.Downloads.IsLoading}"
                           Color="#FFB84D" />

        <VerticalStackLayout x:Name="ErrorPanel"
                             Grid.Row="2"
                             Spacing="8"
                             IsVisible="False">
            <Label x:Name="ErrorLabel" TextColor="Red" />
            <Button x:Name="RetryButton"
                    Text="Erneut laden"
                    Clicked="OnRetryClicked"
                    HorizontalOptions="Start" />
        </VerticalStackLayout>

        <Label x:Name="EmptyLabel"
               Grid.Row="2"
               Text="Keine Downloads vorhanden. Medien lassen sich auf der Detailseite herunterladen."
               IsVisible="False" />

        <!-- Download-Liste: Titel, Zustand, Fortschritt und die Aktionen
             Abbrechen/Erneut versuchen/Löschen je Eintrag. -->
        <CollectionView x:Name="DownloadsCollection"
                        Grid.Row="3"
                        ItemsSource="{Binding Model.Downloads.Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="mvu:DownloadListItem">
                    <Border Padding="12"
                            Margin="0,0,0,10"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="#23232a">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.3" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Title}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#FFDDAA"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding MediaTypeText}"
                                       FontSize="12"
                                       TextColor="#BBBBBB" />
                                <Label Text="{Binding StateText}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding ProgressPercentText}"
                                       FontSize="12"
                                       IsVisible="{Binding ShowProgress}" />
                            </HorizontalStackLayout>
                            <ProgressBar Progress="{Binding Progress}"
                                         ProgressColor="#FFB84D"
                                         IsVisible="{Binding ShowProgress}" />
                            <Label Text="{Binding ErrorText}"
                                   FontSize="12"
                                   TextColor="Red"
                                   IsVisible="{Binding HasError}" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Abbrechen"
                                        FontSize="12"
                                        Clicked="OnCancelClicked"
                                        IsVisible="{Binding CanCancel}" />
                                <Button Text="Erneut versuchen"
                                        FontSize="12"
                                        Clicked="OnRetryDownloadClicked"
                                        IsVisible="{Binding CanRetry}" />
                                <Button Text="Löschen"
                                        FontSize="12"
                                        Clicked="OnDeleteClicked" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
