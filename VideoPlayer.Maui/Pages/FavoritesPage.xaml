<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VideoPlayer.Maui.Controls"
             xmlns:mvu="clr-namespace:VideoPlayer.Mvu;assembly=VideoPlayer.Mvu"
             x:Class="VideoPlayer.Maui.Pages.FavoritesPage"
             x:Name="RootPage"
             Title="Favoriten"
             x:DataType="mvu:MvuHost">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12">

        <!-- Offline-Hinweis: die Liste zeigt die zwischengespeicherte
             Kopie; Entfernen ist ohne Serververbindung nicht möglich. -->
        <Border x:Name="OfflineBanner"
                Grid.Row="0"
                Padding="12,8"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="#D9A029"
                IsVisible="False">
            <Label Text="Offline – es wird die gespeicherte Favoritenliste angezeigt; Entfernen ist ohne Serververbindung nicht möglich."
                   TextColor="Black"
                   FontAttributes="Bold" />
        </Border>

        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="1"
                           IsRunning="{Binding Model.FavoritesPage.IsLoading}"
                           IsVisible="{Binding Model.FavoritesPage.IsLoading}"
                           Color="#FFB84D" />

        <VerticalStackLayout x:Name="ErrorPanel"
                             Grid.Row="1"
                             Spacing="8"
                             IsVisible="False">
            <Label x:Name="ErrorLabel" TextColor="Red" />
            <Button x:Name="RetryButton"
                    Text="Erneut laden"
                    Clicked="OnRetryClicked"
                    HorizontalOptions="Start" />
        </VerticalStackLayout>

        <Label x:Name="EmptyLabel"
               Grid.Row="1"
               Text="Keine Favoriten vorhanden. Markiere Medien auf der Detailseite mit dem Stern."
               IsVisible="False" />

        <!-- Favoritenliste: Poster, Titel und Typ pro Eintrag plus der
             direkten Entfernen-Aktion (Darstellung wie in der
             Webanwendung). Die Auswahl navigiert zur Detailseite. -->
        <CollectionView x:Name="FavoritesCollection"
                        Grid.Row="3"
                        ItemsSource="{Binding Model.FavoritesPage.Items}"
                        SelectionMode="Single"
                        SelectionChanged="OnFavoriteSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="mvu:FavoriteListItem">
                    <Border Padding="10"
                            Margin="0,0,0,10"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="#23232a">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.3" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="72,*,Auto"
                              ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    WidthRequest="72"
                                    HeightRequest="108"
                                    Padding="0"
                                    StrokeThickness="0"
                                    BackgroundColor="#17171c"
                                    StrokeShape="RoundRectangle 6">
                                <Grid>
                                    <!-- Titel-Fallback: liegt unter dem Bild und bleibt sichtbar,
                                         solange kein Poster geladen ist. -->
                                    <Label Text="{Binding Title}"
                                           TextColor="White"
                                           FontSize="11"
                                           Padding="4"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center"
                                           MaxLines="4"
                                           LineBreakMode="WordWrap" />
                                    <controls:CachedPosterImage PictureId="{Binding PosterPictureId}"
                                                                Aspect="AspectFill"
                                                                IsVisible="{Binding HasPoster}" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#FFDDAA"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding MediaTypeText}"
                                       FontSize="13" />
                            </VerticalStackLayout>
                            <Button x:Name="RemoveButton"
                                    Grid.Column="2"
                                    Text="Entfernen"
                                    Clicked="OnRemoveClicked"
                                    IsEnabled="{Binding CanRemove}"
                                    VerticalOptions="Center">
                                <Button.Triggers>
                                    <!-- Offline ist Entfernen gesperrt — der
                                         Server ist führend. -->
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding Source={x:Reference RootPage}, Path=BindingContext.Model.IsOffline}"
                                                 Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
