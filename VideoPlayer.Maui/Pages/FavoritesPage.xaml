<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VideoPlayer.Maui.Controls"
             xmlns:mvu="clr-namespace:VideoPlayer.Mvu;assembly=VideoPlayer.Mvu"
             x:Class="VideoPlayer.Maui.Pages.FavoritesPage"
             x:Name="RootPage"
             Title="Favoriten"
             x:DataType="mvu:MvuHost">

    <Grid Padding="24"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="14">

        <!-- Offline-Hinweis: die Liste zeigt die zwischengespeicherte
             Kopie; Entfernen ist ohne Serververbindung nicht möglich. -->
        <Border x:Name="OfflineBanner"
                Grid.Row="0"
                Style="{StaticResource Banner}"
                IsVisible="False">
            <Label Text="Offline – es wird die gespeicherte Favoritenliste angezeigt; Entfernen ist ohne Serververbindung nicht möglich."
                   TextColor="{StaticResource VpText}"
                   FontFamily="InterMedium" />
        </Border>

        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="1"
                           IsRunning="{Binding Model.FavoritesPage.IsLoading}"
                           IsVisible="{Binding Model.FavoritesPage.IsLoading}"
                           Color="{StaticResource VpPrimary}" />

        <VerticalStackLayout x:Name="ErrorPanel"
                             Grid.Row="1"
                             Spacing="10"
                             IsVisible="False">
            <Label x:Name="ErrorLabel" Style="{StaticResource ErrorText}" />
            <Button x:Name="RetryButton"
                    Text="Erneut laden"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnRetryClicked"
                    HorizontalOptions="Start" />
        </VerticalStackLayout>

        <Label x:Name="EmptyLabel"
               Grid.Row="1"
               Text="Keine Favoriten vorhanden. Markiere Medien auf der Detailseite mit dem Stern."
               Style="{StaticResource Caption}"
               FontSize="14"
               IsVisible="False" />

        <!-- Favoritenliste: Posterkarte, Titel und Typ pro Eintrag plus der
             direkten Entfernen-Aktion. Die Auswahl navigiert zur
             Detailseite. -->
        <CollectionView x:Name="FavoritesCollection"
                        Grid.Row="3"
                        ItemsSource="{Binding Model.FavoritesPage.Items}"
                        SelectionMode="Single"
                        SelectionChanged="OnFavoriteSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="mvu:FavoriteListItem">
                    <Border Style="{StaticResource Card}"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="84,*,Auto"
                              ColumnSpacing="16">
                            <Border Grid.Column="0"
                                    WidthRequest="84"
                                    HeightRequest="126"
                                    Padding="0"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource VpSurfaceLow}"
                                    StrokeShape="RoundRectangle 10">
                                <Grid>
                                    <!-- Titel-Fallback: liegt unter dem Bild und bleibt sichtbar,
                                         solange kein Poster geladen ist. -->
                                    <Label Text="{Binding Title}"
                                           TextColor="{StaticResource VpText}"
                                           FontSize="11"
                                           Padding="6"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center"
                                           MaxLines="4"
                                           LineBreakMode="WordWrap" />
                                    <controls:CachedPosterImage PictureId="{Binding PosterPictureId}"
                                                                Aspect="AspectFill"
                                                                IsVisible="{Binding HasPoster}" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="5"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontFamily="InterSemiBold"
                                       TextColor="{StaticResource VpText}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding MediaTypeText}"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Button x:Name="RemoveButton"
                                    Grid.Column="2"
                                    Text="Entfernen"
                                    Style="{StaticResource SecondaryButton}"
                                    Clicked="OnRemoveClicked"
                                    IsEnabled="{Binding CanRemove}"
                                    VerticalOptions="Center">
                                <Button.Triggers>
                                    <!-- Offline ist Entfernen gesperrt — der
                                         Server ist führend. -->
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding Source={x:Reference RootPage}, Path=BindingContext.Model.IsOffline}"
                                                 Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
