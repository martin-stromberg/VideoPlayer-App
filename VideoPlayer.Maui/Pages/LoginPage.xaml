<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VideoPlayer.Maui.Pages.LoginPage"
             Title="Anmeldung">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">

            <Label Text="Anmeldung"
                   FontSize="24"
                   FontAttributes="Bold" />
            <Label Text="Bitte mit den Zugangsdaten des VideoPlayer-Servers anmelden." />
            <Label x:Name="ServerLabel"
                   AutomationId="LoginServerLabel"
                   FontSize="12"
                   TextColor="{StaticResource VpTextMuted}"
                   IsVisible="false" />

            <Label Text="E-Mail" FontAttributes="Bold" />
            <Entry x:Name="UsernameEntry"
                   AutomationId="LoginUsernameEntry"
                   Placeholder="E-Mail-Adresse"
                   Keyboard="Email" />
            <Label Text="Passwort" FontAttributes="Bold" />
            <Entry x:Name="PasswordEntry"
                   AutomationId="LoginPasswordEntry"
                   Placeholder="Passwort"
                   IsPassword="True" />

            <Button x:Name="LoginButton"
                    AutomationId="LoginButton"
                    Text="Anmelden"
                    Clicked="OnLoginClicked" />
            <ActivityIndicator x:Name="LoginIndicator" IsRunning="false" IsVisible="false" />
            <Label x:Name="ErrorLabel"
                   AutomationId="LoginErrorLabel"
                   TextColor="{StaticResource VpDanger}"
                   IsVisible="false" />

            <!-- Kopplungs-Einstieg: Der Kurzcode der Serververwaltung
                 (Profilseite „Geräte") wird gegen den bereits verbundenen
                 Server eingelöst — ohne Passwort. Der QR-Code bleibt bei
                 der Serververbindung, weil er die Adresse selbst trägt. -->
            <BoxView HeightRequest="1"
                     BackgroundColor="{StaticResource VpBorder}"
                     Margin="0,12" />
            <Label Text="Oder mit Kopplungscode verbinden"
                   FontAttributes="Bold" />
            <Label Text="Kurzcode aus der Serververwaltung (Profilseite „Geräte“) eingeben — er wird gegen den verbundenen Server eingelöst."
                   FontSize="12"
                   TextColor="{StaticResource VpTextMuted}" />
            <Entry x:Name="BootstrapCodeEntry"
                   AutomationId="LoginBootstrapCodeEntry"
                   Placeholder="Kopplungscode"
                   Keyboard="Text"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False" />
            <Button x:Name="BootstrapLoginButton"
                    AutomationId="LoginBootstrapButton"
                    Text="Kopplungscode einlösen"
                    Clicked="OnBootstrapClicked" />
            <ActivityIndicator x:Name="BootstrapIndicator" IsRunning="false" IsVisible="false" />
            <Label x:Name="BootstrapErrorLabel"
                   AutomationId="LoginBootstrapErrorLabel"
                   TextColor="{StaticResource VpDanger}"
                   IsVisible="false" />

            <Button x:Name="ServerSetupButton"
                    AutomationId="LoginServerSetupButton"
                    Text="Anderen Server einrichten"
                    Clicked="OnServerSetupClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
