<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Zielplattformen einzeln abschaltbar (Reporter-Muster): die CI-
         Store-Builds setzen IncludeAndroidTarget/IncludeMacCatalystTarget
         auf false, weil auf dem macOS-Runner nur die iOS-Workload
         installiert wird. Ohne Schalter wuerde ein globales
         -p:TargetFrameworks in die net10.0-Bibliotheken propagiert
         und deren Restore mit NETSDK1147 brechen. -->
    <IncludeIosTarget Condition="'$(IncludeIosTarget)' == ''">true</IncludeIosTarget>
    <IncludeAndroidTarget Condition="'$(IncludeAndroidTarget)' == ''">true</IncludeAndroidTarget>
    <IncludeMacCatalystTarget Condition="'$(IncludeMacCatalystTarget)' == ''">true</IncludeMacCatalystTarget>
    <TargetFrameworks />
    <TargetFrameworks Condition="'$(IncludeAndroidTarget)' == 'true'">$(TargetFrameworks);net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux')) and '$(IncludeIosTarget)' == 'true'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux')) and '$(IncludeMacCatalystTarget)' == 'true'">$(TargetFrameworks);net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>VideoPlayer.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <!-- Display name -->
    <ApplicationTitle>Heimkino</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>de.martinstromberg.videos</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Unpackaged Windows-App (siehe https://aka.ms/MauiTemplateUnpackaged) -->
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Copyright (c) Martin Stromberg</Copyright>
    <Authors>Martin Stromberg</Authors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios' and !$(RuntimeIdentifier.StartsWith('iossimulator'))">
    <!-- Nur Geraete-Builds signieren — Simulator-Builds werden ad-hoc
         signiert und duerfen keinen Keychain-Eintrag voraussetzen
         (CI-Runner ohne Zertifikate; iOS-SDK 27 wertet den Key sonst
         auch im Simulator-Build aus). -->
    <CodesignKey>Apple Development: Created via API (466MVK852A)</CodesignKey>
    <CodesignProvision>VS: WildCard Development</CodesignProvision>
  </PropertyGroup>
  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#131313" />
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0e0e0e" BaseSize="128,128" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.90" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
    <!-- QR-/Ticket-Onboarding: Kamera-Scan nur iOS/Android (MIT-Lizenz;
         ZXing hat keinen Windows-Kamera-Support — Windows/MacCatalyst
         nutzen den manuellen Ticket-Einstieg). -->
    <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4"
                      Condition="'$(TargetFramework)' == 'net10.0-android' or '$(TargetFramework)' == 'net10.0-ios'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VideoPlayer.ApiClient\VideoPlayer.ApiClient.csproj" />
    <ProjectReference Include="..\VideoPlayer.Mvu\VideoPlayer.Mvu.csproj" />
    <ProjectReference Include="..\VideoPlayer.Storage\VideoPlayer.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
