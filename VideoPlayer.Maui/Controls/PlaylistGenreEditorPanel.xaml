<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mvu="clr-namespace:VideoPlayer.Mvu;assembly=VideoPlayer.Mvu"
             x:Class="VideoPlayer.Maui.Controls.PlaylistGenreEditorPanel"
             x:Name="Root">

    <!-- Zentriertes Dialog-Panel des Genre-Editors: die wählbaren
         Genres des Servers als Chip-Zeilen mit Auswahlzustand; unten
         Speichern, Zurücksetzen (berechnete Genres) und Abbrechen —
         bindet an das PlaylistGenreEditor-Feld des MvuHost-BindingContext. -->
    <Grid IsVisible="{Binding Source={x:Reference Root}, Path=IsOpen}">
        <BoxView Color="{StaticResource VpOverlay}" />
        <Border Style="{StaticResource Card}"
                Padding="20"
                WidthRequest="420"
                MaximumHeightRequest="520"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="12">
                <Label Text="Genres"
                       FontSize="18"
                       FontFamily="InterSemiBold"
                       TextColor="{StaticResource VpText}" />

                <ActivityIndicator x:Name="OptionsLoadingIndicator"
                                   AutomationId="GenreEditorLoadingIndicator"
                                   IsRunning="{Binding Source={x:Reference Root}, Path=IsLoading}"
                                   IsVisible="{Binding Source={x:Reference Root}, Path=IsLoading}"
                                   Color="{StaticResource VpPrimary}" />

                <ScrollView VerticalScrollBarVisibility="Always"
                            IsVisible="{Binding Source={x:Reference Root}, Path=HasOptions}">
                    <VerticalStackLayout x:Name="OptionsHost"
                                         Spacing="4" />
                </ScrollView>

                <Label x:Name="OptionsEmptyLabel"
                       AutomationId="GenreEditorEmptyLabel"
                       Text="Es stehen keine Genres zur Auswahl."
                       Style="{StaticResource Caption}"
                       IsVisible="{Binding Source={x:Reference Root}, Path=ShowEmpty}" />

                <Label x:Name="EditorErrorLabel"
                       AutomationId="GenreEditorErrorLabel"
                       Style="{StaticResource ErrorText}"
                       Text="{Binding Source={x:Reference Root}, Path=Error}"
                       IsVisible="{Binding Source={x:Reference Root}, Path=HasError}" />

                <VerticalStackLayout Spacing="8">
                    <Button x:Name="SaveButton"
                            AutomationId="GenreEditorSaveButton"
                            Text="Speichern"
                            Clicked="OnSaveClicked" />
                    <HorizontalStackLayout Spacing="12">
                        <Button x:Name="ResetButton"
                                AutomationId="GenreEditorResetButton"
                                Text="Zurücksetzen"
                                Style="{StaticResource SecondaryButton}"
                                Clicked="OnResetClicked" />
                        <Button x:Name="CancelButton"
                                AutomationId="GenreEditorCancelButton"
                                Text="Abbrechen"
                                Style="{StaticResource SecondaryButton}"
                                Clicked="OnCancelClicked"
                                HorizontalOptions="End" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
