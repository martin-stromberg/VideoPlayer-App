<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VideoPlayer.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:VideoPlayer.Maui.Pages"
    Title="VideoPlayer"
    FlyoutBehavior="Flyout">

    <FlyoutItem Title="Startseite" Route="home">
        <ShellContent Title="Startseite" ContentTemplate="{DataTemplate pages:HomePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Quellen" Route="sources">
        <ShellContent Title="Quellen" ContentTemplate="{DataTemplate pages:SourcesPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Favoriten" Route="favorites">
        <ShellContent Title="Favoriten" ContentTemplate="{DataTemplate pages:FavoritesPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Downloads" Route="downloads">
        <ShellContent Title="Downloads" ContentTemplate="{DataTemplate pages:DownloadsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Profil" Route="profile">
        <ShellContent Title="Profil" ContentTemplate="{DataTemplate pages:ProfilePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Einstellungen" Route="settings">
        <ShellContent Title="Einstellungen" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </FlyoutItem>

</Shell>
