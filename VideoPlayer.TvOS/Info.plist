<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bundle-Identifier, Name und Versionen injiziert der Build aus den
         MSBuild-Properties ApplicationId / ApplicationDisplayVersion /
         ApplicationVersion. -->
    <!-- 3 = Apple TV -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>3</integer>
    </array>
    <!-- Vorbereitung der Server-Discovery (MdnsServerDiscovery in
         VideoPlayer.ApiClient nutzt Zeroconf mit _http._tcp.local.):
         tvOS verlangt fuer mDNS im lokalen Netzwerk dieselben
         Datenschutzschluessel wie iOS. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Die App sucht im lokalen Netzwerk nach Video-Servern.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_http._tcp</string>
    </array>
    <!-- Die App verwendet keine nicht-freigestellte Verschluesselung —
         deckungsgleich mit der iOS-Info.plist; ohne den Schluessel
         verlangt App Store Connect eine Export-Compliance-Angabe pro
         Build. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- Lokale Medienwiedergabe und unverschluesselte lokale
         Server-Verbindungen (LAN), analog zur iOS-App. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- App-Icon + Top-Shelf: SDK ersetzt den Platzhalter beim
         actool-Lauf durch CFBundleIcons/TVTopShelfImage
         (App-Store-Pflicht, Muster aus dem dotnet-tvos-Template). -->
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/App Icon &amp; Top Shelf Image.brandassets</string>
</dict>
</plist>
